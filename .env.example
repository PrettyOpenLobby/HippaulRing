# Copy to .env and edit. An EMPTY value always means "use the built-in
# default", never "empty string as the value". OpenLobby's tools/stack.py (and
# the by-hand command in README.md) reads OpenLobby's .env first and this one
# second.

# The address game clients use to reach this host (LAN/VPN/public IP), when it
# differs from the core's. Default when empty: POL_ADVERTISE from OpenLobby's
# .env, and 127.0.0.1 (same-machine testing only) when that is empty too.
FE_ADVERTISE=

# The world name, shown in Fantasy Earth's world picker and on the Viewer's
# profile for a Fantasy Earth Content ID. Empty: PlayOnline.
POL_FE_WORLD=
