# The Fantasy Earth title plugin, layered on the OpenLobby core image.
#
# The game's own services build from services/Dockerfile. This image is the
# core plus the two modules that run INSIDE the core's login and authsess
# processes: the plugin, and the player database it reads.
# docker-compose.title.yml swaps it in for those two services. Build the core
# first, or point OPENLOBBY_IMAGE at the image you use (a title image, to
# stack titles).
ARG OPENLOBBY_IMAGE=openlobby:latest
FROM ${OPENLOBBY_IMAGE}

COPY services/festore.py /app/festore.py
COPY services/fetitle.py /app/fetitle.py

ENV POL_TITLES=fetitle
